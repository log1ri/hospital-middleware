POSTGRES_USER=staff
POSTGRES_DB=hospital
POSTGRES_PASSWORD=

# Host is localhost for `make run`; docker compose overrides it to reach the
# postgres service by name.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

JWT_SECRET=
JWT_EXPIRATION=7200

# Required, with no default on purpose: leaving it unset must not quietly send
# real traffic to the real hospital. Use http://127.0.0.1:8081 for the local
# dummy HIS, or https://hospital-a.api.co.th for the real one. Docker compose
# overrides this and points app at its own his-a-dummy service.
HOSPITAL_A_BASE_URL=http://127.0.0.1:8081

# Port the API listens on inside the compose network. nginx proxies to it and
# the container health check uses it; it is not published to the host.
APP_PORT=8080

# Port nginx is published on. This is the one you call from your machine.
HTTP_PORT=8080

# development or production. Defaults to production when unset. Use development
# for per-request logs and route dumps while working on the app.
APP_ENV=production
